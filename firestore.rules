rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validLeaderboardEntry(entryId) {
      return request.resource.data.keys().hasOnly([
               'nickname', 'nicknameKey', 'score', 'stage', 'wpm', 'combo',
               'grade', 'playTimeSec', 'playTimeStr', 'date', 'createdAt'
             ])
             && request.resource.data.nickname is string
             && request.resource.data.nickname.size() >= 1
             && request.resource.data.nickname.size() <= 20
             && request.resource.data.nicknameKey is string
             && request.resource.data.nicknameKey.size() >= 1
             && request.resource.data.nicknameKey.size() <= 20
             && entryId == request.resource.data.nicknameKey
             && request.resource.data.score is number
             && request.resource.data.score >= 0
             && request.resource.data.score <= 999999
             && request.resource.data.stage is number
             && request.resource.data.stage >= 1
             && request.resource.data.stage <= 9999;
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if validLeaderboardEntry(entryId);
      allow update: if validLeaderboardEntry(entryId)
                    && request.resource.data.nicknameKey == resource.data.nicknameKey
                    && (
                      request.resource.data.stage > resource.data.stage
                      || (
                        request.resource.data.stage == resource.data.stage
                        && request.resource.data.score > resource.data.score
                      )
                    );
      allow delete: if false;
    }

    match /suggestions/{docId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['text', 'nickname', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() <= 20;
      allow update, delete: if false;
    }
  }
}
